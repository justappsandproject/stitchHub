{
  "name": "stitchhub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Multi-tenant SaaS platform for fashion businesses",
  "scripts": {
    "dev": "pnpm --filter @stitchhub/shared build && pnpm -r --parallel --filter @stitchhub/api --filter @stitchhub/web --filter @stitchhub/shared dev",
    "dev:api": "pnpm --filter @stitchhub/api dev",
    "dev:web": "pnpm --filter @stitchhub/web dev",
    "dev:shared": "pnpm --filter @stitchhub/shared dev",
    "build": "pnpm --filter @stitchhub/api... build",
    "build:api": "pnpm --filter @stitchhub/api... build",
    "render:build": "pnpm install --prod=false && pnpm --filter @stitchhub/api... build",
    "start:api": "node apps/api/dist/src/main.js",
    "db:generate": "pnpm --filter @stitchhub/api db:generate",
    "db:migrate": "pnpm --filter @stitchhub/api db:migrate",
    "db:push": "pnpm --filter @stitchhub/api db:push",
    "db:seed": "pnpm --filter @stitchhub/api db:seed",
    "dev:mobile": "pnpm --filter @stitchhub/shared build && cd apps/mobile && flutter run",
    "dev:mobile:android": "bash scripts/dev-mobile-android.sh",
    "build:mobile:apk": "cd apps/mobile && flutter build apk --release",
    "build:mobile:apk:debug": "cd apps/mobile && flutter build apk --debug",
    "install:mobile:android": "bash scripts/install-mobile-android.sh debug",
    "install:mobile:android:release": "bash scripts/install-mobile-android.sh release"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
