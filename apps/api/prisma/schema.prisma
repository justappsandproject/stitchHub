generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (PgBouncer) for app queries
  url      = env("DATABASE_URL")
  // Direct connection for migrations and db push
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  TENANT_OWNER
  MANAGER
  TAILOR
  CUTTER
  FINISHER
  APPRENTICE
  CUSTOMER
}

enum OrderStatus {
  NEW
  MEASURED
  CUTTING
  SEWING
  FITTING
  FINISHING
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  PAYSTACK
  FLUTTERWAVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MeasurementCategory {
  MEN
  WOMEN
  CHILDREN
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountApplicability {
  ALL_ORDERS
  FIRST_ORDER
  VIP_ONLY
  MINIMUM_SPEND
}

enum PortfolioSource {
  MANUAL
  ORDER
}

enum InventoryTransactionType {
  RESTOCK
  USAGE
  ADJUSTMENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum FinancialType {
  INCOME
  EXPENDITURE
  PETTY_CASH
}

enum MessageSenderType {
  STAFF
  CUSTOMER
}

// ─── Platform ────────────────────────────────────────────────────────────────

model Tenant {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  email       String
  phone       String?
  address     String?
  logoUrl     String?  @map("logo_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users                User[]
  customers            Customer[]
  measurementTemplates MeasurementTemplate[]
  measurements         Measurement[]
  styles               Style[]
  orders               Order[]
  invoices             Invoice[]
  payments             Payment[]
  receipts             Receipt[]
  auditLogs            AuditLog[]
  subscription         Subscription?
  platformMessages     PlatformMessage[]
  subscriptionPayments SubscriptionPayment[]
  portfolioItems       PortfolioItem[]
  discounts            Discount[]
  inventoryProducts    InventoryProduct[]
  conversationMessages ConversationMessage[]
  tickets              Ticket[]
  financialEntries     FinancialEntry[]
  customerStyleSelections CustomerStyleSelection[]

  @@map("tenants")
}

model PlatformMessage {
  id        String    @id @default(cuid())
  tenantId  String    @map("tenant_id")
  senderId  String    @map("sender_id")
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("platform_messages")
}

model SubscriptionPayment {
  id          String           @id @default(cuid())
  tenantId    String           @map("tenant_id")
  plan        SubscriptionPlan
  amount      Decimal          @db.Decimal(12, 2)
  reference   String           @unique
  paystackRef String?          @map("paystack_ref")
  status      String           @default("PENDING")
  createdAt   DateTime         @default(now()) @map("created_at")
  paidAt      DateTime?        @map("paid_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscription_payments")
}

model Subscription {
  id                 String             @id @default(cuid())
  tenantId           String             @unique @map("tenant_id")
  plan               SubscriptionPlan   @default(FREE)
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── Auth & Users ────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  tenantId     String?   @map("tenant_id")
  email        String    @unique
  passwordHash String    @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  phone        String?
  photoUrl     String?   @map("photo_url")
  username     String?   @unique
  pin          String?
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  mustResetPassword Boolean @default(false) @map("must_reset_password")
  invitedAt    DateTime? @map("invited_at")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  deviceTokens      DeviceToken[]
  customer      Customer?
  assignedOrders Order[]       @relation("AssignedWorker")
  auditLogs     AuditLog[]
  platformMessages PlatformMessage[]
  measurementsTaken Measurement[] @relation("MeasurementTakenBy")
  sentMessages  ConversationMessage[] @relation("MessageSender")
  ticketReplies TicketReply[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String
  platform  String   @default("android")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("device_tokens")
}

// ─── Customer Management ─────────────────────────────────────────────────────

model Customer {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  userId      String?   @unique @map("user_id")
  username    String?   @map("username")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  phone       String
  email       String?
  gender      Gender?
  dateOfBirth DateTime? @map("date_of_birth")
  address     String?
  photoUrl    String?   @map("photo_url")
  notes       String?
  isVip       Boolean   @default(false) @map("is_vip")
  tags        String[]  @default([])
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  measurements Measurement[]
  orders       Order[]
  styleSelections CustomerStyleSelection[]
  tickets      Ticket[]
  conversationMessages ConversationMessage[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, deletedAt])
  @@map("customers")
}

// ─── Digital Measurement Vault ───────────────────────────────────────────────

model MeasurementTemplate {
  id        String              @id @default(cuid())
  tenantId  String              @map("tenant_id")
  name      String
  category  MeasurementCategory
  fields    Json
  isDefault Boolean             @default(false) @map("is_default")
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  measurements Measurement[]

  @@index([tenantId])
  @@map("measurement_templates")
}

model Measurement {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  templateId String   @map("template_id")
  version    Int      @default(1)
  values     Json
  unit       String   @default("cm")
  photoUrls  String[] @default([]) @map("photo_urls")
  notes      String?
  takenBy    String?  @map("taken_by")
  takenById  String?  @map("taken_by_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  template MeasurementTemplate @relation(fields: [templateId], references: [id])
  takenByUser User?            @relation("MeasurementTakenBy", fields: [takenById], references: [id], onDelete: SetNull)
  revisions MeasurementRevision[]
  orders    Order[]

  @@index([tenantId])
  @@index([customerId])
  @@map("measurements")
}

model MeasurementRevision {
  id            String   @id @default(cuid())
  measurementId String   @map("measurement_id")
  version       Int
  values        Json
  notes         String?
  revisedBy     String?  @map("revised_by")
  createdAt     DateTime @default(now()) @map("created_at")

  measurement Measurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@index([measurementId])
  @@map("measurement_revisions")
}

// ─── Style Catalog ─────────────────────────────────────────────────────────────

model Style {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  name        String
  category    String
  description String?
  photoUrls   String[] @default([]) @map("photo_urls")
  videoUrls   String[] @default([]) @map("video_urls")
  basePrice   Decimal? @map("base_price") @db.Decimal(12, 2)
  stockQuantity Int    @default(0) @map("stock_quantity")
  tags        String[] @default([])
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]
  customerStyleSelections CustomerStyleSelection[]

  @@index([tenantId])
  @@map("styles")
}

// ─── Portfolio & Promotions ────────────────────────────────────────────────────

model PortfolioItem {
  id          String          @id @default(cuid())
  tenantId    String          @map("tenant_id")
  orderId     String?         @unique @map("order_id")
  title       String
  description String?
  category    String?
  fabric      String?
  styleName   String?         @map("style_name")
  photoUrls   String[]        @default([]) @map("photo_urls")
  completedAt DateTime?       @map("completed_at")
  source      PortfolioSource @default(MANUAL)
  isFeatured  Boolean         @default(false) @map("is_featured")
  isPublished Boolean         @default(true) @map("is_published")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, isPublished])
  @@map("portfolio_items")
}

model Discount {
  id             String                @id @default(cuid())
  tenantId       String                @map("tenant_id")
  code           String
  name           String
  description    String?
  type           DiscountType
  value          Decimal               @db.Decimal(12, 2)
  applicability  DiscountApplicability @default(ALL_ORDERS)
  minOrderAmount Decimal?              @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscountCap Decimal?              @map("max_discount_cap") @db.Decimal(12, 2)
  maxUses        Int?                  @map("max_uses")
  usedCount      Int                   @default(0) @map("used_count")
  validFrom      DateTime?             @map("valid_from")
  validUntil     DateTime?             @map("valid_until")
  isActive       Boolean               @default(true) @map("is_active")
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("discounts")
}

// ─── Order Management ──────────────────────────────────────────────────────────

model Order {
  id              String        @id @default(cuid())
  tenantId        String        @map("tenant_id")
  customerId      String        @map("customer_id")
  styleId         String?       @map("style_id")
  orderNumber     String        @map("order_number")
  fabric          String?
  deliveryDate    DateTime?     @map("delivery_date")
  priority        OrderPriority @default(NORMAL)
  status          OrderStatus   @default(NEW)
  notes           String?
  assignedToId    String?       @map("assigned_to_id")
  discountId      String?       @map("discount_id")
  subtotalAmount  Decimal       @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal       @default(0) @map("total_amount") @db.Decimal(12, 2)
  depositAmount   Decimal       @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  balanceAmount   Decimal       @default(0) @map("balance_amount") @db.Decimal(12, 2)
  measurementId   String?       @map("measurement_id")
  styleReferenceUrls String[]   @default([]) @map("style_reference_urls")
  discountType    String?       @map("discount_type")
  confirmedAt     DateTime?     @map("confirmed_at")
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id])
  style        Style?              @relation(fields: [styleId], references: [id])
  discount     Discount?           @relation(fields: [discountId], references: [id], onDelete: SetNull)
  assignedTo   User?               @relation("AssignedWorker", fields: [assignedToId], references: [id])
  measurement  Measurement?        @relation(fields: [measurementId], references: [id], onDelete: SetNull)
  statusHistory OrderStatusHistory[]
  invoices     Invoice[]
  portfolioItem PortfolioItem?

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
  @@index([customerId])
  @@map("orders")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String      @map("order_id")
  status    OrderStatus
  notes     String?
  changedBy String?     @map("changed_by")
  createdAt DateTime    @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

// ─── Payments ──────────────────────────────────────────────────────────────────

model Invoice {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  orderId       String        @map("order_id")
  invoiceNumber String        @map("invoice_number")
  amount        Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @map("paid_amount") @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?     @map("due_date")
  pdfUrl        String?       @map("pdf_url")
  sentAt        DateTime?     @map("sent_at")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id])
  payments Payment[]

  @@unique([orderId])
  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@map("invoices")
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String        @map("tenant_id")
  invoiceId     String?       @map("invoice_id")
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  reference     String?
  gatewayRef    String?       @map("gateway_ref")
  notes         String?
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  receipt Receipt?

  @@index([tenantId])
  @@index([reference])
  @@map("payments")
}

model Receipt {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  paymentId     String   @unique @map("payment_id")
  receiptNumber String   @map("receipt_number")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id])

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@map("receipts")
}

// ─── Audit ─────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?  @map("tenant_id")
  userId     String?  @map("user_id")
  actorType  String?  @map("actor_type")
  action     String
  entity     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model InventoryProduct {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  name              String
  category          String?
  description       String?
  sku               String?
  photoUrls         String[] @default([]) @map("photo_urls")
  unitCost          Decimal  @default(0) @map("unit_cost") @db.Decimal(12, 2)
  unitPrice         Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  supplier          String?
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@index([tenantId])
  @@index([tenantId, category])
  @@map("inventory_products")
}

model InventoryTransaction {
  id          String                   @id @default(cuid())
  tenantId    String                   @map("tenant_id")
  productId   String                   @map("product_id")
  type        InventoryTransactionType
  quantity    Int
  previousQty Int                      @map("previous_qty")
  newQty      Int                      @map("new_qty")
  unitCost    Decimal?                 @map("unit_cost") @db.Decimal(12, 2)
  supplier    String?
  notes       String?
  createdBy   String?                  @map("created_by")
  createdAt   DateTime                 @default(now()) @map("created_at")

  product InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([productId])
  @@map("inventory_transactions")
}

// ─── Customer Style Selections ────────────────────────────────────────────────

model CustomerStyleSelection {
  id         String   @id @default(cuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  styleId    String?  @map("style_id")
  photoUrl   String?  @map("photo_url")
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  style    Style?   @relation(fields: [styleId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_style_selections")
}

// ─── Tenant ↔ Customer Messaging ─────────────────────────────────────────────

model ConversationMessage {
  id           String            @id @default(cuid())
  tenantId     String            @map("tenant_id")
  customerId   String            @map("customer_id")
  senderId     String            @map("sender_id")
  senderType   MessageSenderType @map("sender_type")
  content      String?
  attachments  String[]          @default([])
  read         Boolean           @default(false)
  createdAt    DateTime          @default(now()) @map("created_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sender   User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, read])
  @@map("conversation_messages")
}

// ─── Support Tickets ─────────────────────────────────────────────────────────

model Ticket {
  id          String       @id @default(cuid())
  tenantId    String       @map("tenant_id")
  customerId  String       @map("customer_id")
  subject     String
  category    String
  description String
  status      TicketStatus @default(OPEN)
  attachments String[]     @default([])
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  replies  TicketReply[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("tickets")
}

model TicketReply {
  id         String   @id @default(cuid())
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  authorType MessageSenderType @map("author_type")
  content    String
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_replies")
}

// ─── Financials ──────────────────────────────────────────────────────────────

model FinancialEntry {
  id          String        @id @default(cuid())
  tenantId    String        @map("tenant_id")
  type        FinancialType
  direction   String?
  category    String
  description String
  amount      Decimal       @db.Decimal(12, 2)
  receiptUrl  String?       @map("receipt_url")
  orderId     String?       @map("order_id")
  recordedBy  String        @map("recorded_by")
  entryDate   DateTime      @map("entry_date")
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, entryDate])
  @@map("financial_entries")
}
