# Database (Supabase)
# Use the SESSION POOLER string (Dashboard → Connect → Session pooler).
# Notes:
# - The direct connection (db.*.supabase.co) is IPv6-only and won't work on IPv4-only networks.
# - sslmode=require is needed for the Prisma query engine to connect through the pooler.
# - URL-encode special characters in the password (@ -> %40, ! -> %21, etc).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# Local Postgres alternative (docker compose up -d):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/stitchhub?schema=public"
# DIRECT_URL="postgresql://postgres:password@localhost:5432/stitchhub?schema=public"

# JWT
JWT_SECRET="change-me-in-production-use-long-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-use-long-random-string"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Payment gateways — add keys to enable Paystack subscription billing
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_CALLBACK_URL="http://localhost:3000/dashboard/billing"

# Cloudflare R2 (Phase 2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="stitchhub"
